# Both hostnames, because both are in use and missing one breaks payments.
#
#   api.balans.ng      the WhatsApp webhook Meta calls
#   payment.balans.ng  PUBLIC_BASE_URL — the origin in every /i/{token} link
#                      a client opens to pay
#
# Cloudflare sits in front of both. Set Cloudflare's SSL mode to Full (strict):
# "Flexible" would make Cloudflare talk plain HTTP to this box, and Meta's
# webhook signature is checked over a connection that must be the one it
# thinks it is.

{
	# No `auto_https off` here, deliberately. An explicit `tls` directive on a
	# site already stops Caddy managing certificates for it, which is the part
	# that has to stop. Turning automatic HTTPS off wholesale would also drop
	# the port 80 listener and the redirect that goes with it, so a plain HTTP
	# request would hit nothing at all.

	# Caddy's own logs stay quiet; the API does the logging that matters.
	log {
		level ERROR
	}
}

api.balans.ng, payment.balans.ng {
	/*
	 * Cloudflare's Origin certificate, not Let's Encrypt.
	 *
	 * Caddy's automatic HTTPS is the better default nearly everywhere, and it
	 * is the wrong one here. Behind Cloudflare's proxy an HTTP-01 challenge
	 * has to survive the edge — Always Use HTTPS, redirect rules, caching —
	 * and each failed attempt counts against a rate limit that is per
	 * hostname per hour. Getting that wrong during a cutover means the site
	 * is down and the fix is to wait.
	 *
	 * Cloudflare is the only thing that ever talks to this box, and it trusts
	 * its own Origin CA. So the certificate is issued once, by hand, valid
	 * until 2041, and nothing has to be renewed or negotiated at boot.
	 *
	 * The pair lives in /opt/balans/certs, outside the repository, for the
	 * same reason .env does.
	 */
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	reverse_proxy api:4000 {
		# Fastify runs with trustProxy, so it reads these for the real client
		# IP rather than seeing Caddy's address on every request.
		header_up X-Real-IP {remote_host}
	}

	encode gzip

	# One line per request, kept for a week. Enough to answer "did Meta
	# actually call us?" without filling a 2GB disk.
	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}
