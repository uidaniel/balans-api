# Copy to .env.local. Never commit the real file.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres. Neon/Supabase free tier is fine for the beta.
DATABASE_URL=postgres://user:pass@host/balans
DATABASE_SSL=true

# Entity switch (PRD section 14)
LEGAL_ENTITY_NAME=MOTX Studios
PUBLIC_BASE_URL=http://localhost:3000
SUPPORT_EMAIL=hello@balans.ng

# WhatsApp Cloud API. The test token from Meta's dashboard lasts 24 hours.
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
# Any string you choose; paste the same one into Meta's webhook form.
WA_VERIFY_TOKEN=
# App secret from Meta > App settings > Basic. Signs every inbound webhook.
WA_APP_SECRET=

# Monnify
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# 32 bytes base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
