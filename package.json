{
  "name": "balans-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Balans backend: WhatsApp bot, documents, payments.",
  "scripts": {
    "dev": "node --env-file=.env.local --watch --experimental-strip-types src/index.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "migrate": "node --env-file=.env.local --experimental-strip-types src/db/migrate.ts",
    "reset": "node --env-file=.env.local --experimental-strip-types src/db/reset-user.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-reporter=spec \"src/**/*.test.ts\" \"core/**/*.test.ts\""
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "undici": "^8.10.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.3"
  }
}
